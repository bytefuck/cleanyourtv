<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a qualifier can swap them: font resources need
     Android 8, so on older sets (this fork runs from Android 6, API 23) these name the system's own
     families, values-v26 points them at the bundled Outfit, and values-vi always uses the system
     sans-serif because Outfit has no glyphs for most Vietnamese accented letters (#833). -->
<resources>
    <string name="font_body" translatable="false">sans-serif</string>
    <string name="font_regular" translatable="false">sans-serif</string>
    <string name="font_light" translatable="false">sans-serif-light</string>
    <string name="font_extralight" translatable="false">sans-serif-thin</string>
    <string name="font_medium" translatable="false">sans-serif-medium</string>
</resources>
